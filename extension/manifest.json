{
  "manifest_version": 3,
  "name": "Local Autofill",
  "version": "0.4.0",
  "description": "Preview and approve local profile data before filling forms.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
